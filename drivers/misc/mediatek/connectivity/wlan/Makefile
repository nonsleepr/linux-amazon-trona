# MediaTek's vendor WiFi stack for the connectivity subsystem: the adaptor
# that switches the WiFi function on through the WMT core, and the "gen3"
# WLAN driver. They are built with different sets of -D flags.
#

obj-$(CONFIG_MTK_COMBO_WIFI)	+= adaptor/
obj-$(CONFIG_MTK_COMBO_WIFI)	+= core/gen3/
